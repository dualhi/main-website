---
/**
 * BIO / ABOUT
 * Text left, press photo right (stacks on mobile). Highlight stat box.
 */
import { Image } from 'astro:assets';
import bioImg from '../assets/bio.jpg';
import { SITE } from '../lib/site';
---

<section id="about" class="border-t border-paper/10 bg-ink py-24 md:py-32">
  <div class="container-x">
    <p class="eyebrow">02 — About</p>
    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
      <!-- Text -->
      <div>
        <h2 class="text-5xl md:text-7xl">Dualhï</h2>

        <div class="mt-8 space-y-5 text-base leading-relaxed text-paper/70 md:text-lg">
          <p>
            Dualhï is an Italian DJ and producer duo formed by Cristiano Gautier
            and Kevin Romero. Born in 2017 from the evolution of an early big
            room project started in 2012, they blend dance, pop and electronic
            elements into a modern, emotional and energetic sound that resonates
            on festival stages and streaming playlists alike.
          </p>
          <p>
            Their music has earned strong international support from Martin
            Garrix, Sam Feldt, The Him, Dash Berlin, Sick Individuals, Gregory
            Klosman, Rudeejay and Iceleak. With 18 official releases and more
            than 8.5 million streams — including “Chase My Dreams” (1.3M+) and
            “Animals” (1M+) — their tracks have been featured in editorial
            Spotify playlists such as “Dance Brandneu” and released on labels
            like Universal Music Group, Actuation, SMASH THE HOUSE and Broke.
          </p>
          <p>
            The duo is now signed to Bamboo Artists, the largest independent
            music label, publisher and management company in the GSA region.
            Recent releases include “Slide It Over” and “Run It Back” on
            Funfair and “Don't Say It Out Loud” on Oury / Broke, followed by
            their latest single “Lose Control” on the label, which entered the
            Shazam Dance chart in France at #154 and the Apple Music Dance
            chart in Gabon at #96.
          </p>
        </div>

        <!-- Highlight stat -->
        <div class="mt-10 inline-flex flex-col border border-paper/20 px-8 py-6">
          <span class="font-display text-5xl leading-none md:text-6xl">{SITE.stat.value}</span>
          <span class="mt-2 font-sans text-xs uppercase tracking-[0.3em] text-paper/50">
            {SITE.stat.label}
          </span>
        </div>
      </div>

      <!-- Press photo -->
      <div class="relative aspect-[4/5] overflow-hidden bg-paper/5">
        <Image
          src={bioImg}
          alt="Dualhï press photo"
          class="h-full w-full object-cover"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 45vw, 90vw"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
