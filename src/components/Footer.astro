---
/**
 * FOOTER — small wordmark, primary social links, copyright.
 */
import { SITE } from '../lib/site';
import wordmark from '../assets/logo/wordmark.svg?raw';

const year = new Date().getFullYear();
---

<footer class="border-t border-paper/10 bg-ink py-14">
  <div class="container-x flex flex-col items-center gap-8 text-center">
    <div class="w-40 text-paper/80">
      <Fragment set:html={wordmark} />
      <span class="sr-only">{SITE.name}</span>
    </div>

    <p class="font-sans text-xs uppercase tracking-[0.2em] text-paper/30">
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  footer :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
