---
/**
 * HERO
 * ----
 * Initial screen: full black, two "scaglie" (shards) centered & overlapping
 * to form a diamond. On scroll (GSAP ScrollTrigger, see ../scripts/hero.ts):
 *   - shard 1 slides left off-screen with a slight scale-up
 *   - shard 2 slides right off-screen with a slight scale-up
 *   - behind them, the press photo + DUALHÏ wordmark fade in (wordmark delayed)
 *
 * SVGs are inlined (?raw) so `currentColor` and per-path styling work, and so
 * GSAP can transform them directly. Swapping the placeholder art = replacing
 * the files in src/assets/logo/.
 */
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.jpg';
import { SITE } from '../lib/site';

// Inline shard + wordmark markup.
import scaglia1 from '../assets/logo/scaglia-1.svg?raw';
import scaglia2 from '../assets/logo/scaglia-2.svg?raw';
import wordmark from '../assets/logo/wordmark.svg?raw';
---

<section id="hero" class="relative bg-ink" aria-label="Dualhï">
  <!-- Pinned stage: stays fixed while the scroll drives the animation. -->
  <div class="hero-pin relative h-[100svh] w-full overflow-hidden">

    <!-- Background press photo + wordmark: hidden initially, revealed on scroll. -->
    <div class="hero-content absolute inset-0 opacity-0">
      <Image
        src={heroBg}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Darkening overlay for wordmark legibility. -->
      <div class="absolute inset-0 bg-ink/55"></div>

      <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
        <div class="hero-wordmark w-[80vw] max-w-[640px] text-paper opacity-0">
          <Fragment set:html={wordmark} />
          <span class="sr-only">{SITE.name}</span>
        </div>
        <p class="hero-tagline mt-6 font-sans text-sm uppercase tracking-[0.35em] text-paper/70 opacity-0 md:text-base">
          {SITE.tagline}
        </p>
      </div>
    </div>

    <!-- The two shards, centered and overlapping (diamond). -->
    <div class="hero-scaglie absolute inset-0 flex items-center justify-center">
      <div class="scaglia scaglia-1 -mr-4 w-[36vw] max-w-[260px] text-paper md:w-[22vw]">
        <Fragment set:html={scaglia1} />
      </div>
      <div class="scaglia scaglia-2 scaglia--outline -ml-4 w-[36vw] max-w-[260px] text-paper md:w-[22vw]">
        <Fragment set:html={scaglia2} />
      </div>
    </div>

    <!-- Scroll cue. -->
    <div class="hero-scroll-cue pointer-events-none absolute bottom-6 left-1/2 -translate-x-1/2 text-paper/60">
      <span class="block text-[10px] uppercase tracking-[0.3em]">Scroll</span>
      <span class="mx-auto mt-2 block h-6 w-px animate-pulse bg-paper/60"></span>
    </div>
  </div>
</section>

<style>
  /* Inlined SVGs should fill their wrapper. */
  .scaglia :global(svg),
  .hero-wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Default colour treatment (overridable when real assets land):
     shard 1 = solid white, shard 2 = white outline for depth/contrast. */
  .scaglia--outline :global(svg path) {
    fill: transparent;
    stroke: currentColor;
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<!-- Hero scroll animation (GSAP + ScrollTrigger). Bundled by Astro. -->
<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>
