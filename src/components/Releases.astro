---
/**
 * LATEST RELEASES
 * Auto-generated grid. Each card = one folder in content/releases/.
 * Hovering a cover reveals the Dualhï shards + a play button; clicking it
 * opens a popup with the artwork, a Spotify preview and streaming links.
 */
import { Image } from 'astro:assets';
import { getReleases } from '../lib/content';

const releases = getReleases();

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
function formatDate(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : dateFmt.format(d);
}

/** Public Spotify page for the release. */
function toOpenUrl(embedUrl: string): string {
  const m = embedUrl?.match(
    /embed\/(track|album|playlist|episode|show)\/([A-Za-z0-9]+)/i,
  );
  return m ? `https://open.spotify.com/${m[1].toLowerCase()}/${m[2]}` : '';
}

/** Spotify first, then whatever extra links the release declares. */
function linksFor(r: { spotifyEmbedUrl: string; links?: Record<string, string> }) {
  const out: Record<string, string> = {};
  const sp = toOpenUrl(r.spotifyEmbedUrl);
  if (sp) out.Spotify = sp;
  for (const [k, v] of Object.entries(r.links ?? {})) if (v) out[k] = v;
  return out;
}
---

<section id="releases" class="bg-ink py-24 md:py-32">
  <div class="container-x">
    <p class="eyebrow">01 — Music</p>
    <h2 class="mt-3 text-5xl md:text-7xl">Latest Releases</h2>

    {releases.length === 0 ? (
      <p class="mt-10 text-paper/50">
        No releases yet. Add a folder under <code>content/releases/</code>.
      </p>
    ) : (
      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {releases.map((r) => (
          <article class="group flex flex-col">
            <div class="relative aspect-square overflow-hidden bg-paper/5">
              {r.cover && (
                <button
                  type="button"
                  data-open
                  data-title={r.title}
                  data-embed={r.spotifyEmbedUrl}
                  data-links={JSON.stringify(linksFor(r))}
                  aria-label={`${r.title} — listen`}
                  class="absolute inset-0 block h-full w-full cursor-pointer"
                >
                  <Image
                    src={r.cover}
                    alt={`${r.title} cover art`}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                    loading="lazy"
                  />

                  <span class="pointer-events-none absolute inset-0 bg-ink/25 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>

                  <span class="pointer-events-none absolute left-5 top-5 text-paper">
                    <svg
                      viewBox="0 0 2734 2336"
                      aria-hidden="true"
                      class="h-7 w-auto -translate-y-2 opacity-0 transition duration-500 group-hover:translate-y-0 group-hover:opacity-95"
                    >
                      <path
                        fill="currentColor"
                        d="M2671.48 2277.77C2696.91 2302.75 2717.7 2294.02 2717.7 2258.39V80.8857C2717.7 45.2463 2688.54 16.0869 2652.9 16.0869H1013.75C978.106 16.0869 948.945 45.2463 948.945 80.8857V520.378C948.945 556.017 969.753 605.617 995.169 630.601L2671.48 2277.77Z"
                      />
                      <path
                        fill="currentColor"
                        d="M62.4222 37.7783C36.9952 12.7949 16.2002 21.5171 16.2002 57.1565V2255C16.2002 2290.64 45.3611 2319.8 81.0023 2319.8H1735.75C1771.39 2319.8 1800.55 2290.64 1800.55 2255V1810.5C1800.55 1774.86 1779.75 1725.26 1754.32 1700.27L62.4222 37.7783Z"
                      />
                    </svg>
                  </span>

                  <span class="pointer-events-none absolute bottom-5 left-5 flex h-14 w-14 items-center justify-center rounded-full border border-paper/80 bg-ink/30 opacity-0 backdrop-blur-sm transition duration-500 group-hover:scale-110 group-hover:opacity-100">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-0.5 h-5 w-5 text-paper">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              )}
            </div>

            <div class="mt-5 flex items-baseline justify-between gap-4">
              <h3 class="font-display text-xl uppercase tracking-tight">{r.title}</h3>
              <time class="shrink-0 font-sans text-xs uppercase tracking-widest text-paper/40">
                {formatDate(r.releaseDate)}
              </time>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-16 border-t border-paper/10 pt-8">
      <a
        href="/music"
        class="group inline-flex items-center gap-4 text-paper transition hover:text-paper/60"
      >
        <span class="font-display text-2xl uppercase tracking-tightest md:text-4xl">
          Discover more music
        </span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          class="h-5 w-5 shrink-0 transition-transform duration-500 ease-out-expo group-hover:translate-x-2 md:h-7 md:w-7"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
      <p class="mt-2 font-sans text-xs uppercase tracking-[0.25em] text-paper/40">
        Full discography
      </p>
    </div>
  </div>
</section>

<div
  data-modal
  role="dialog"
  aria-modal="true"
  aria-label="Release"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/90 p-5 backdrop-blur-sm"
>
  <div class="relative w-full max-w-sm border border-paper/15 bg-ink" data-modal-panel>
    <button
      type="button"
      data-modal-close
      aria-label="Close"
      class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-ink/60 text-paper backdrop-blur-sm transition hover:bg-paper hover:text-ink"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="h-4 w-4">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>

    <img data-modal-cover alt="" class="aspect-square w-full object-cover" />

    <div class="p-6">
      <h3 data-modal-title class="font-display text-2xl uppercase tracking-tight"></h3>
      <p class="mt-1 font-sans text-xs uppercase tracking-[0.3em] text-paper/40">Dualhï</p>

      <div data-modal-player class="mt-5"></div>

      <p class="mt-7 text-center font-sans text-[0.65rem] uppercase tracking-[0.3em] text-paper/40">
        Listen on
      </p>
      <div data-modal-links class="mt-3 grid grid-cols-2 gap-px bg-paper/15"></div>
    </div>
  </div>
</div>

<script>
  const modal = document.querySelector('[data-modal]');
  const panel = modal?.querySelector('[data-modal-panel]');
  const cover = modal?.querySelector('[data-modal-cover]') as HTMLImageElement | null;
  const title = modal?.querySelector('[data-modal-title]');
  const playerBox = modal?.querySelector('[data-modal-player]');
  const linksBox = modal?.querySelector('[data-modal-links]');

  function close() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    if (playerBox) playerBox.innerHTML = ''; // stops the audio
    document.body.style.overflow = '';
  }

  function open(btn: HTMLElement) {
    if (!modal || !cover || !title || !playerBox || !linksBox) return;

    const img = btn.querySelector('img');
    cover.src = (img && (img.currentSrc || img.src)) || '';
    cover.alt = btn.getAttribute('data-title') || '';
    title.textContent = btn.getAttribute('data-title') || '';

    const embed = btn.getAttribute('data-embed') || '';
    playerBox.innerHTML = embed
      ? `<iframe src="${embed}" width="100%" height="80" frameborder="0" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" class="rounded-lg" title="Spotify preview"></iframe>`
      : '';

    let links: Record<string, string> = {};
    try {
      links = JSON.parse(btn.getAttribute('data-links') || '{}');
    } catch {}
    linksBox.innerHTML = Object.entries(links)
      .map(
        ([name, url]) =>
          `<a href="${url}" target="_blank" rel="noopener noreferrer" class="bg-ink px-3 py-3 text-center font-sans text-xs uppercase tracking-widest text-paper/70 transition hover:bg-paper hover:text-ink">${name}</a>`,
      )
      .join('');

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  document.querySelectorAll('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => open(btn as HTMLElement));
  });

  modal?.querySelector('[data-modal-close]')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (panel && !panel.contains(e.target as Node)) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
