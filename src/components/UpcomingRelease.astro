---
/**
 * OUT NOW — the current single, announced loud.
 *
 * Deliberately the heaviest block on the page after the hero: big artwork,
 * display-size title and filled buttons straight to the streaming services,
 * so the single outweighs the catalogue sitting below it.
 *
 * For the next single, swap the constants below. Before release day add back
 * a countdown; after it, leave the buttons pointing at the track.
 */
const TITLE = 'Last Time';
const ARTISTS = 'Dualhï & Angie Robba';
const COVER = '/covers/last-time.jpg';

/** Out now since 3 November 2026 on Bamboo Artists. */
const SPOTIFY = 'https://open.spotify.com/track/4VxFDfOeMU2ok0PHT12u9z';
const APPLE = 'https://music.apple.com/us/album/6823162709';
const ALL_PLATFORMS = 'https://dualhixangierobba.lnk.to/LastTime';
const HREF = ALL_PLATFORMS;
---

<section class="border-t border-paper/10 bg-ink py-20 md:py-28">
  <div class="container-x">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- Artwork -->
      <a
        href={HREF}
        class="group relative block aspect-square overflow-hidden bg-paper/5"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={COVER}
          alt=""
          width="1200"
          height="1200"
          class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Copy -->
      <div>
        <p class="eyebrow">New single — Out now</p>

        <h2 class="mt-5 text-[min(3.75rem,13vw)] leading-[0.95] md:text-8xl">
          {TITLE}
        </h2>

        <p class="mt-4 flex items-center gap-3 font-sans text-sm text-paper/60 md:text-base">
          <span class="inline-block h-px w-8 bg-paper/40"></span>
          {ARTISTS}
        </p>

        <!-- Listen -->
        <div class="mt-9 flex flex-wrap gap-3 sm:gap-4">
          <a
            href={SPOTIFY}
            target="_blank"
            rel="noopener"
            class="inline-block border border-paper bg-paper px-10 py-5 font-sans text-xs uppercase tracking-[0.2em] text-ink transition hover:bg-transparent hover:text-paper md:text-sm"
          >
            Listen on Spotify
          </a>
          <a
            href={APPLE}
            target="_blank"
            rel="noopener"
            class="inline-block border border-paper/40 px-10 py-5 font-sans text-xs uppercase tracking-[0.2em] text-paper transition hover:border-paper md:text-sm"
          >
            Apple Music
          </a>
        </div>

        <a
          href={ALL_PLATFORMS}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block font-sans text-xs uppercase tracking-[0.2em] text-paper/60 underline-offset-4 transition hover:text-paper hover:underline"
        >
          All platforms →
        </a>
      </div>
    </div>
  </div>
</section>
