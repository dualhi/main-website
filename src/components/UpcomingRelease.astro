---
/**
 * UPCOMING RELEASE — announcement strip for the next single.
 *
 * Sits between the hero and "Latest Releases" and points at the pre-save
 * page. Remove this component from src/pages/index.astro on release day,
 * once the track moves into the catalogue.
 */
const TITLE = 'Last Time';
const ARTISTS = 'Dualhï & Angie Robba';
const OUT_ON = 'Out November 3';
const COVER = '/covers/last-time.jpg';
const HREF = '/last-time/';
---

<section class="border-t border-paper/10 bg-ink py-12 md:py-16">
  <div class="container-x">
    <a
      href={HREF}
      class="group flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8"
      aria-label={`${TITLE} — ${OUT_ON}. Pre-save it.`}
    >
      <!-- Artwork -->
      <div class="relative aspect-square w-24 shrink-0 overflow-hidden bg-paper/5 sm:w-28">
        <img
          src={COVER}
          alt={`${TITLE} cover art`}
          width="600"
          height="600"
          class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Title block -->
      <div class="min-w-0 flex-1">
        <p class="eyebrow">New single — {OUT_ON}</p>

        <h2 class="mt-3 text-[min(2.5rem,11vw)] leading-none md:text-5xl">
          {TITLE}
        </h2>

        <p class="mt-2 flex items-center gap-3 font-sans text-sm text-paper/60">
          <span class="inline-block h-px w-6 bg-paper/40"></span>
          {ARTISTS}
        </p>
      </div>

      <!-- Call to action -->
      <span
        class="shrink-0 self-start border border-paper/25 px-7 py-4 font-sans text-xs uppercase tracking-[0.2em] text-paper transition group-hover:bg-paper group-hover:text-ink sm:self-auto"
      >
        Pre-save
      </span>
    </a>
  </div>
</section>
