---
/**
 * LAST TIME — out now.
 *
 * Campaign landing page. The single is out, so this page sends straight to the
 * streaming services: no countdown, no email form, no pre-save. Traffic gets
 * here from the ads — the page is deliberately not linked from the site.
 *
 * For the next single, copy this page and swap the constants below.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

/** Out now since 3 November 2026 on Bamboo Artists. */
const SPOTIFY = 'https://open.spotify.com/track/4VxFDfOeMU2ok0PHT12u9z';
const APPLE = 'https://music.apple.com/us/album/6823162709';

/** Smart link from the label: everywhere else, YouTube Music included. */
const ALL_PLATFORMS = 'https://dualhixangierobba.lnk.to/LastTime';

/** Direct links, verified on release day. */
const MORE = [
  { label: 'Amazon Music', href: 'https://music.amazon.com/tracks/B0HN55R932' },
  { label: 'Deezer', href: 'https://www.deezer.com/track/4355092812' },
  { label: 'Tidal', href: 'https://tidal.com/track/570128422' },
];
---

<BaseLayout
  title="Last Time — Dualhï & Angie Robba"
  description="Last Time, the new single from Dualhï with Angie Robba, is out now. Listen on Spotify, Apple Music and everywhere else."
  ogImage="/covers/last-time.jpg"
>
  <main class="bg-ink">
    <section class="py-20 md:py-28">
      <div class="container-x">
        <a
          href="/"
          class="font-sans text-xs uppercase tracking-[0.3em] text-paper/50 transition hover:text-paper"
        >
          &larr; Home
        </a>

        <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
          <!-- Artwork -->
          <a
            href={ALL_PLATFORMS}
            target="_blank"
            rel="noopener"
            class="group relative block aspect-square overflow-hidden bg-paper/5"
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src="/covers/last-time.jpg"
              alt=""
              width="1200"
              height="1200"
              class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
          </a>

          <!-- Copy -->
          <div>
            <p class="eyebrow">New single &mdash; Out now</p>

            <h1 class="mt-5 text-[min(3.5rem,13vw)] leading-[0.95] md:text-8xl">
              Last Time
            </h1>

            <p class="mt-4 flex items-center gap-3 font-sans text-sm text-paper/60 md:text-base">
              <span class="inline-block h-px w-8 bg-paper/40"></span>
              Dualh&iuml; &amp; Angie Robba
            </p>

            <p class="mt-9 max-w-md font-sans text-base leading-relaxed text-paper/70">
              Out now on Bamboo Artists. Pick where you listen.
            </p>

            <!-- Listen -->
            <div class="mt-7 flex flex-wrap gap-3 sm:gap-4">
              <a
                href={SPOTIFY}
                target="_blank"
                rel="noopener"
                class="inline-block border border-paper bg-paper px-10 py-5 font-sans text-xs uppercase tracking-[0.2em] text-ink transition hover:bg-transparent hover:text-paper md:text-sm"
              >
                Listen on Spotify
              </a>
              <a
                href={APPLE}
                target="_blank"
                rel="noopener"
                class="inline-block border border-paper/40 px-10 py-5 font-sans text-xs uppercase tracking-[0.2em] text-paper transition hover:border-paper md:text-sm"
              >
                Apple Music
              </a>
            </div>

            <!-- The rest, kept quieter -->
            <ul class="mt-7 flex flex-wrap gap-x-7 gap-y-3 font-sans text-xs uppercase tracking-[0.2em] text-paper/50">
              {
                MORE.map((service) => (
                  <li>
                    <a
                      href={service.href}
                      target="_blank"
                      rel="noopener"
                      class="underline-offset-4 transition hover:text-paper hover:underline"
                    >
                      {service.label}
                    </a>
                  </li>
                ))
              }
            </ul>

            <a
              href={ALL_PLATFORMS}
              target="_blank"
              rel="noopener"
              class="mt-7 inline-block font-sans text-xs uppercase tracking-[0.2em] text-paper/60 underline-offset-4 transition hover:text-paper hover:underline"
            >
              All platforms &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
