---
/**
 * LAST TIME — pre-save page.
 * Collects the email on our own list, then hands off to the label's pre-save.
 * The /music catalogue entry ships separately on release day.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

/** Release: 3 November 2026, midnight CET. */
const RELEASE_ISO = '2026-11-03T00:00:00+01:00';
/** Official Linkfire pre-save supplied by Bamboo Artists. */
const PRESAVE_URL = 'https://dualhixangierobba.lnk.to/LastTime';
---

<BaseLayout
  title="Last Time — Dualhï & Angie Robba"
  description="Last Time, the new single from Dualhï with Angie Robba, is out 3 November 2026. Leave your email and pre-save it."
  ogImage="/covers/last-time.jpg"
>
  <main class="bg-ink">
    <section class="py-20 md:py-28">
      <div class="container-x">
        <a
          href="/"
          class="font-sans text-xs uppercase tracking-[0.3em] text-paper/50 transition hover:text-paper"
        >
          ← Home
        </a>

        <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
          <!-- Artwork -->
          <div class="relative aspect-square overflow-hidden bg-paper/5">
            <img
              src="/covers/last-time.jpg"
              alt="Last Time — artwork"
              width="1200"
              height="1200"
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>

          <!-- Testo + form -->
          <div>
            <p class="eyebrow">New single</p>

            <h1 class="mt-5 text-[min(3.5rem,13vw)] md:text-8xl">Last Time</h1>

            <p class="mt-4 flex items-center gap-3 font-sans text-sm text-paper/60">
              <span class="inline-block h-px w-8 bg-paper/40"></span>
              Dualhï &amp; Angie Robba
            </p>

            <!-- Countdown -->
            <div
              id="countdown"
              class="mt-9 flex gap-4 font-sans sm:gap-6"
              data-release={RELEASE_ISO}
              aria-live="polite"
            >
              <div>
                <span data-cd="d" class="block font-display text-4xl leading-none md:text-5xl">—</span>
                <span class="mt-2 block text-[0.6rem] uppercase tracking-[0.25em] text-paper/40">Days</span>
              </div>
              <div>
                <span data-cd="h" class="block font-display text-4xl leading-none md:text-5xl">—</span>
                <span class="mt-2 block text-[0.6rem] uppercase tracking-[0.25em] text-paper/40">Hours</span>
              </div>
              <div>
                <span data-cd="m" class="block font-display text-4xl leading-none md:text-5xl">—</span>
                <span class="mt-2 block text-[0.6rem] uppercase tracking-[0.25em] text-paper/40">Minutes</span>
              </div>
              <div>
                <span data-cd="s" class="block font-display text-4xl leading-none md:text-5xl">—</span>
                <span class="mt-2 block text-[0.6rem] uppercase tracking-[0.25em] text-paper/40">Seconds</span>
              </div>
            </div>

            <p class="mt-9 max-w-md font-sans text-base leading-relaxed text-paper/70">
              Out November 3. Leave your email and we&rsquo;ll tell you the moment
              it lands. Pre-save it now and it goes straight into your library.
            </p>

            <!-- Form -->
            <form
              id="presave-form"
              name="presave-last-time"
              method="POST"
              data-netlify="true"
              netlify-honeypot="company"
              class="mt-7 max-w-md"
              novalidate
            >
              <!-- Netlify: identifies the form in the dashboard. -->
              <input type="hidden" name="form-name" value="presave-last-time" />
              <!-- Bot trap: hidden, a filled-in value gets the submission dropped. -->
              <p class="hidden">
                <label>Leave this empty: <input name="company" /></label>
              </p>
              <div class="flex flex-col gap-3 sm:flex-row">
                <label for="email" class="sr-only">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  inputmode="email"
                  placeholder="your email"
                  class="w-full min-w-0 border border-paper/25 bg-transparent px-5 py-4 font-sans text-sm text-paper placeholder:text-paper/35 focus:border-paper focus:outline-none"
                />
                <button
                  type="submit"
                  class="shrink-0 border border-paper bg-paper px-7 py-4 font-sans text-xs uppercase tracking-[0.2em] text-ink transition hover:bg-transparent hover:text-paper"
                >
                  Pre-save
                </button>
              </div>

              <p class="mt-4 font-sans text-xs leading-relaxed text-paper/40">
                By leaving your email you agree to hear from Dualhï about new
                releases. No spam, and one click unsubscribes you from any message.
              </p>

              <p
                id="form-msg"
                class="mt-4 hidden font-sans text-sm text-paper/70"
                role="status"
                aria-live="polite"
              ></p>
            </form>

          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ PRESAVE_URL }}>
  // ---- Countdown -------------------------------------------------------
  const box = document.getElementById('countdown');
  if (box) {
    const target = new Date(box.dataset.release).getTime();
    const cell = (k) => box.querySelector(`[data-cd="${k}"]`);
    const pad = (n) => String(n).padStart(2, '0');

    const tick = () => {
      const left = target - Date.now();
      if (left <= 0) {
        box.innerHTML =
          '<p class="font-display text-3xl uppercase leading-none">Out now</p>';
        return;
      }
      const secs = Math.floor(left / 1000);
      cell('d').textContent = pad(Math.floor(secs / 86400));
      cell('h').textContent = pad(Math.floor(secs / 3600) % 24);
      cell('m').textContent = pad(Math.floor(secs / 60) % 60);
      cell('s').textContent = pad(secs % 60);
    };

    tick();
    setInterval(tick, 1000);
  }

  // ---- Form ------------------------------------------------------------
  const form = document.getElementById('presave-form');
  const msg = document.getElementById('form-msg');

  const say = (text) => {
    msg.textContent = text;
    msg.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const input = form.querySelector('#email');
    const button = form.querySelector('button[type="submit"]');
    const email = input.value.trim();

    if (!input.checkValidity() || !email) {
      say('Check the address — something looks off.');
      input.focus();
      return;
    }

    button.disabled = true;
    button.textContent = 'One moment…';

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'content-type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          'form-name': 'presave-last-time',
          email,
          company: '',
        }).toString(),
      });

      if (!res.ok) throw new Error(String(res.status));

      say('Done. Opening the pre-save…');
      // Hands off to the label's pre-save. If anything gets in the way,
      // the "Go straight to the pre-save" link is still right there.
      window.location.href = PRESAVE_URL;
    } catch {
      // Our problem, not theirs: a failed save must never cost us the
      // pre-save, so send them through anyway.
      say('Opening the pre-save…');
      window.location.href = PRESAVE_URL;
    }
  });
</script>
