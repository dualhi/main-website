---
/**
 * MUSIC — full discography.
 * Featured newest release on top, then everything grouped by year
 * with a client-side year filter. Data comes from content/releases.json.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { getCatalogue, getCatalogueByYear, isNewRelease } from '../../lib/content';
import { SITE } from '../../lib/site';

const all = getCatalogue();
const featured = all[0];
const byYear = getCatalogueByYear();
const years = byYear.map((g) => g.year);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const fmt = (iso: string) => dateFmt.format(new Date(iso));
---

<BaseLayout
  title={`Music — ${SITE.name}`}
  description={`Every Dualhï release, ${years[years.length - 1]} to ${years[0]}.`}
>
  <main class="bg-ink">
    <!-- Featured: the newest release. -->
    <section class="border-b border-paper/10 py-24 md:py-32">
      <div class="container-x">
        <a
          href="/"
          class="font-sans text-xs uppercase tracking-[0.3em] text-paper/50 transition hover:text-paper"
        >
          ← Home
        </a>

        <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <div class="flex items-center gap-4">
              {isNewRelease(featured.releaseDate) && (
                <span class="bg-paper px-2 py-1 font-sans text-[0.6rem] uppercase tracking-[0.2em] text-ink">
                  New release
                </span>
              )}
              <time class="font-sans text-xs uppercase tracking-[0.25em] text-paper/50">
                {fmt(featured.releaseDate)}
              </time>
            </div>

            <h1 class="mt-6 text-6xl md:text-8xl">{featured.title}</h1>
            <p class="mt-4 flex items-center gap-3 font-sans text-sm text-paper/60">
              <span class="inline-block h-px w-8 bg-paper/40"></span>
              {featured.artists}
            </p>

            <div class="mt-9 flex flex-wrap gap-3">
              {featured.spotifyUrl && (
                <a
                  href={featured.spotifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-paper/25 px-6 py-3 font-sans text-xs uppercase tracking-[0.2em] text-paper transition hover:bg-paper hover:text-ink"
                >
                  Spotify
                </a>
              )}
              <a
                href={featured.appleUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-paper/25 px-6 py-3 font-sans text-xs uppercase tracking-[0.2em] text-paper transition hover:bg-paper hover:text-ink"
              >
                Apple Music
              </a>
            </div>
          </div>

          <div class="relative aspect-square overflow-hidden bg-paper/5">
            <img
              src={featured.cover}
              alt={`${featured.title} cover art`}
              width="600"
              height="600"
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Everything, grouped by year. -->
    <section class="py-24 md:py-32">
      <div class="container-x">
        <p class="eyebrow">01 — Music</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-8">
          <h2 class="text-5xl md:text-7xl">All Releases</h2>

          <div class="flex flex-wrap gap-x-5 gap-y-2" role="group" aria-label="Filter by year">
            <button
              type="button"
              data-year-filter="all"
              aria-pressed="true"
              class="year-chip font-sans text-xs uppercase tracking-[0.25em] text-paper/40 transition hover:text-paper"
            >
              All
            </button>
            {years.map((y) => (
              <button
                type="button"
                data-year-filter={y}
                aria-pressed="false"
                class="year-chip font-sans text-xs uppercase tracking-[0.25em] text-paper/40 transition hover:text-paper"
              >
                {y}
              </button>
            ))}
          </div>
        </div>

        <p class="mt-4 font-sans text-sm text-paper/40">
          {all.length} releases — {years[years.length - 1]} to {years[0]}
        </p>

        {byYear.map((group) => (
          <div data-year-group={group.year} class="relative mt-20 first:mt-16">
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-10 left-0 select-none font-display text-[7rem] leading-none text-paper/[0.04] md:text-[12rem]"
            >
              {group.year}
            </span>

            <h3 class="relative font-sans text-xs uppercase tracking-[0.3em] text-paper/50">
              {group.year}
            </h3>

            <div class="relative mt-8 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((r) => (
                <article class="group flex flex-col">
                  <a
                    href={r.spotifyUrl ?? r.appleUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="relative block aspect-square overflow-hidden bg-paper/5"
                    aria-label={`${r.title} — listen`}
                  >
                    <img
                      src={r.cover}
                      alt={`${r.title} cover art`}
                      width="600"
                      height="600"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="pointer-events-none absolute inset-0 bg-ink/25 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
                    {isNewRelease(r.releaseDate) && (
                      <span class="absolute left-4 top-4 bg-paper px-2 py-1 font-sans text-[0.55rem] uppercase tracking-[0.2em] text-ink">
                        New
                      </span>
                    )}
                  </a>

                  <time class="mt-5 font-sans text-[0.65rem] uppercase tracking-[0.25em] text-paper/40">
                    {fmt(r.releaseDate)}
                  </time>
                  <h4 class="mt-2 font-display text-xl uppercase leading-tight tracking-tight">
                    {r.title}
                  </h4>
                  <p class="mt-1 flex items-baseline gap-2 font-sans text-xs text-paper/50">
                    <span class="inline-block h-px w-5 shrink-0 bg-paper/30"></span>
                    {r.artists}
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .year-chip[aria-pressed='true'] {
    color: rgb(var(--paper, 255 255 255));
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-year-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-year-group]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const year = chip.dataset.yearFilter;

      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      groups.forEach((g) => {
        g.hidden = year !== 'all' && g.dataset.yearGroup !== year;
      });
    });
  });
</script>
